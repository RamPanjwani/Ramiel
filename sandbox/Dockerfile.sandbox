# Ramiel Code Sandbox — Minimal Offline Runtime
# This container is ALWAYS launched with --network none.
# No network tools, no package managers, no curl/wget.

FROM python:3.12-slim

# Strip network utilities — belt-and-suspenders with --network none
RUN apt-get update && \
    apt-get remove -y --purge curl wget && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Non-root execution
RUN useradd -m -s /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

COPY entrypoint.sh /home/sandbox/entrypoint.sh

ENTRYPOINT ["/bin/bash", "/home/sandbox/entrypoint.sh"]
